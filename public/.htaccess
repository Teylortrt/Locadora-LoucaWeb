DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Se a requisição NÃO for para um arquivo físico que exista na pasta...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    
    # ...então redireciona tudo, absolutamente TUDO, para o index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
